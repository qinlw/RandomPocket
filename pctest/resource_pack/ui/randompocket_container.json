{
  "namespace": "randompocket_container",

  "custom_grid_item@common.container_item": {
    "$item_collection_name": "netease_ui_container"
  },

  "randompocket_pocket_grid": {
    "type": "grid",
    "size": [ 90, "100.0%c" ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "grid_dimensions": [ 5, 2 ],
    "grid_item_template": "randompocket_container.custom_grid_item",
    "collection_name": "netease_ui_container",
    "maximum_grid_items": 10
  },

  "container_label": {
    "type": "label",
    "offset": [ 7, -1 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "$container_title|default": "随机口袋",
    "text": "$container_title",
    "size": [ "90%", "default" ],
    "color": "$title_text_color",
    "layer": 2
  },

  "selected_item_details@common.selected_item_details": {
    "offset": [ 0, 0 ]
  },

  "randompocket_panel_top_half": {
    "type": "panel",
    "size": [ "100%", "100.0%c" ],
    "offset": [ 0, 11 ],
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "controls": [
      {
        "container_label@randompocket_container.container_label": {}
      },
      {
        "randompocket_grid1@randompocket_container.randompocket_pocket_grid": {
          "offset": [ 7, 10 ]
        }
      }
    ]
  },

  "randompocket_panel": {
    "type": "panel",
    "controls": [
      {
        "test_buttons@randompocket_container.test_buttons": {}
      },
      {
        "pool_dialog@randompocket_container.pool_dialog": {}
      },
      {
        "container_gamepad_helpers@common.container_gamepad_helpers": {}
      },
      {
        "flying_item_renderer@common.flying_item_renderer": {
          "layer": 11
        }
      },
      {
        "selected_item_details_factory@common.selected_item_details_factory": {
          "control_name": "@randompocket_container.selected_item_details"
        }
      },
      {
        "item_lock_notification_factory@common.item_lock_notification_factory": {
          "control_name": "@common.item_lock_notification"
        }
      },
      {
        "root_panel@common.root_panel": {
          "size": [ 176, 220 ],
          "layer": 1,
          "controls": [
            {
              "common_panel@common.common_panel": {
                "size": [ "100%", "100.0%c" ],
                "$dialog_background|default": "common.dialog_background_opaque",
                "controls": [
                  {
                    "bg_image@$dialog_background": {
                      "size": [ "100%", "100.0%c+-37.0px" ],
                      "layer": 1,
                      "controls": [
                        {
                          "chest_panel": {
                            "type": "panel",
                            "layer": 5,
                            "size": [ "100%", "100.0%c+-7.0px" ],
                            "controls": [
                              {
                                "randompocket_panel_top_half@randompocket_container.randompocket_panel_top_half": {}
                              },
                              {
                                "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {}
                              },
                              {
                                "hotbar_grid@common.hotbar_grid_template": {}
                              }
                            ]
                          }
                        },
                        {
                          "inventory_selected_icon_button@common.inventory_selected_icon_button": {}
                        },
                        {
                          "gamepad_cursor@common.gamepad_cursor_button": {}
                        },
                        {
                          "close@common.close_button": {
                            "layer": "$close_button_layer",
                            "offset": "$close_button_offset",
                            "ignored": "$use_compact_close_button"
                          }
                        },
                        {
                          "compact_close@common.compact_close_button": {
                            "layer": "$close_button_layer",
                            "offset": "$close_button_offset",
                            "ignored": "(not $use_compact_close_button)"
                          }
                        }
                      ],
                      "bindings": [
                        {
                          "binding_name": "$close_button_visible_binding_name",
                          "binding_name_override": "#visible"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "test_buttons": {
    "type": "panel",
    "size": [ 0, 0 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "offset": [ 128, -42 ],
    "layer": 20,
    "visible": false,
    "controls": [
      {
        "btn_pool@randompocket_container.test_button": {
          "$label_text": "查看奖池",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 0 ]
        }
      },
      {
        "btn_refresh@randompocket_container.test_button": {
          "$label_text": "刷新一天",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 28 ]
        }
      }
    ]
  },

  "test_button": {
    "type": "button",
    "anchor_from": "center",
    "anchor_to": "center",
    "size": [ 86, 24 ],
    "layer": 2,
    "visible": true,
    "button_mappings": [],
    "is_handle_button_move_event": true,
    "$label_text": "按钮",
    "controls": [
      {
        "default": {
          "type": "image",
          "texture": "textures/netease/common/button/default",
          "layer": 2
        }
      },
      {
        "hover": {
          "type": "image",
          "texture": "textures/netease/common/button/hover",
          "layer": 2
        }
      },
      {
        "pressed": {
          "type": "image",
          "texture": "textures/netease/common/button/pressed",
          "layer": 2
        }
      },
      {
        "button_label": {
          "type": "label",
          "color": [ 1, 1, 1 ],
          "font_size": "normal",
          "font_type": "smooth",
          "layer": 3,
          "max_size": [ "100%", "100%" ],
          "shadow": false,
          "text": "$label_text",
          "text_alignment": "center"
        }
      }
    ]
  },

  "pool_cell": {
    "type": "button",
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": [ 22, 22 ],
    "layer": 4,
    "visible": true,
    "button_mappings": [],
    "is_handle_button_move_event": true,
    "controls": [
      {
        "default": {
          "type": "image",
          "texture": "textures/ui/rp_btn_default",
          "layer": 1
        }
      },
      {
        "hover": {
          "type": "image",
          "texture": "textures/ui/rp_btn_hover",
          "layer": 1
        }
      },
      {
        "pressed": {
          "type": "image",
          "texture": "textures/ui/rp_btn_pressed",
          "layer": 1
        }
      },
      {
        "icon": {
          "type": "image",
          "texture": "textures/netease/common/image/default",
          "anchor_from": "center",
          "anchor_to": "center",
          "size": [ 18, 18 ],
          "layer": 2,
          "visible": false
        }
      }
    ]
  },

  "pool_dialog": {
    "type": "panel",
    "size": [ 160, 200 ],
    "anchor_from": "center",
    "anchor_to": "center",
    "layer": 30,
    "visible": false,
    "controls": [
      {
        "bg@randompocket_container.test_button": {
          "$label_text": "",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "size": [ "100%", "100%" ],
          "layer": 1,
          "controls": [
            {
              "default": {
                "type": "image",
                "texture": "textures/ui/dialog_background_opaque",
                "layer": 1
              }
            },
            {
              "hover": {
                "type": "image",
                "texture": "textures/ui/dialog_background_opaque",
                "layer": 1
              }
            },
            {
              "pressed": {
                "type": "image",
                "texture": "textures/ui/dialog_background_opaque",
                "layer": 1
              }
            }
          ]
        }
      },
      {
        "title_label": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 8, 6 ],
          "size": [ 144, 12 ],
          "text": "奖池",
          "color": [ 1, 1, 1 ],
          "font_size": "normal",
          "font_type": "smooth",
          "shadow": true,
          "text_alignment": "left",
          "layer": 2
        }
      },
      {
        "search_box@common.text_edit_box": {
          "$edit_box_default_texture": "textures/ui/edit_box_indent",
          "$edit_box_hover_texture": "textures/ui/edit_box_indent_hover",
          "$is_new_nine_slice": false,
          "$nine_slice_buttom": 0,
          "$nine_slice_left": 0,
          "$nine_slice_right": 0,
          "$nine_slice_top": 0,
          "$nineslice_size": [ 0, 0, 0, 0 ],
          "$place_holder_text": "输入ID或中文名",
          "$place_holder_text_color": [ 0.5, 0.5, 0.5 ],
          "$text_background_default": "netease_editor_template_namespace.edit_box_background_default",
          "$text_background_hover": "netease_editor_template_namespace.edit_box_background_hover",
          "$text_box_text_color": [ 1, 1, 1 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 8, 22 ],
          "size": [ 96, 18 ],
          "enabled_newline": false,
          "max_length": 64,
          "layer": 3
        }
      },
      {
        "btn_search@randompocket_container.test_button": {
          "$label_text": "搜索",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 108, 22 ],
          "size": [ 44, 18 ],
          "layer": 3
        }
      },
      {
        "cell_0@randompocket_container.pool_cell": { "offset": [ 8, 44 ] }
      },
      {
        "cell_1@randompocket_container.pool_cell": { "offset": [ 32, 44 ] }
      },
      {
        "cell_2@randompocket_container.pool_cell": { "offset": [ 56, 44 ] }
      },
      {
        "cell_3@randompocket_container.pool_cell": { "offset": [ 80, 44 ] }
      },
      {
        "cell_4@randompocket_container.pool_cell": { "offset": [ 104, 44 ] }
      },
      {
        "cell_5@randompocket_container.pool_cell": { "offset": [ 128, 44 ] }
      },
      {
        "cell_6@randompocket_container.pool_cell": { "offset": [ 8, 68 ] }
      },
      {
        "cell_7@randompocket_container.pool_cell": { "offset": [ 32, 68 ] }
      },
      {
        "cell_8@randompocket_container.pool_cell": { "offset": [ 56, 68 ] }
      },
      {
        "cell_9@randompocket_container.pool_cell": { "offset": [ 80, 68 ] }
      },
      {
        "cell_10@randompocket_container.pool_cell": { "offset": [ 104, 68 ] }
      },
      {
        "cell_11@randompocket_container.pool_cell": { "offset": [ 128, 68 ] }
      },
      {
        "cell_12@randompocket_container.pool_cell": { "offset": [ 8, 92 ] }
      },
      {
        "cell_13@randompocket_container.pool_cell": { "offset": [ 32, 92 ] }
      },
      {
        "cell_14@randompocket_container.pool_cell": { "offset": [ 56, 92 ] }
      },
      {
        "cell_15@randompocket_container.pool_cell": { "offset": [ 80, 92 ] }
      },
      {
        "cell_16@randompocket_container.pool_cell": { "offset": [ 104, 92 ] }
      },
      {
        "cell_17@randompocket_container.pool_cell": { "offset": [ 128, 92 ] }
      },
      {
        "cell_18@randompocket_container.pool_cell": { "offset": [ 8, 116 ] }
      },
      {
        "cell_19@randompocket_container.pool_cell": { "offset": [ 32, 116 ] }
      },
      {
        "cell_20@randompocket_container.pool_cell": { "offset": [ 56, 116 ] }
      },
      {
        "cell_21@randompocket_container.pool_cell": { "offset": [ 80, 116 ] }
      },
      {
        "cell_22@randompocket_container.pool_cell": { "offset": [ 104, 116 ] }
      },
      {
        "cell_23@randompocket_container.pool_cell": { "offset": [ 128, 116 ] }
      },
      {
        "name_label": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 8, 142 ],
          "size": [ 144, 12 ],
          "text": "点图标查看名称",
          "color": [ 0.8, 0.8, 0.8 ],
          "font_size": "small",
          "font_type": "smooth",
          "shadow": true,
          "text_alignment": "center",
          "layer": 2
        }
      },
      {
        "page_label": {
          "type": "label",
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 8, 156 ],
          "size": [ 144, 12 ],
          "text": "1/1",
          "color": [ 1, 1, 1 ],
          "font_size": "small",
          "font_type": "smooth",
          "shadow": true,
          "text_alignment": "center",
          "layer": 2
        }
      },
      {
        "btn_prev@randompocket_container.test_button": {
          "$label_text": "上页",
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [ 8, -8 ],
          "size": [ 36, 18 ],
          "layer": 3
        }
      },
      {
        "btn_close@randompocket_container.test_button": {
          "$label_text": "关闭",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [ 0, -8 ],
          "size": [ 40, 18 ],
          "layer": 3
        }
      },
      {
        "btn_next@randompocket_container.test_button": {
          "$label_text": "下页",
          "anchor_from": "bottom_right",
          "anchor_to": "bottom_right",
          "offset": [ -8, -8 ],
          "size": [ 36, 18 ],
          "layer": 3
        }
      }
    ]
  },

  "randompocket_container_screen@common.inventory_screen_common": {
    "$close_on_player_hurt|default": true,
    "close_on_player_hurt": "$close_on_player_hurt",
    "variables": [
      {
        "requires": "$desktop_screen",
        "$screen_content": "randompocket_container.randompocket_panel",
        "$screen_bg_content": "common.screen_background",
        "$screen_background_alpha": 0.4
      },
      {
        "requires": "$pocket_screen",
        "$screen_content": "randompocket_container.randompocket_panel"
      }
    ]
  }
}
